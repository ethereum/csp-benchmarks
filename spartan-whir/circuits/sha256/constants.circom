pragma circom 2.2.3;

// SHA-256 constants from circom/circomlib/circuits/sha256/constants.circom.
// Store 16-bit halves so every constant fits in KoalaBear before shifting.
function Sha256InitialBit(word, bit) {
    var limbs[8][2] = [
        [58983, 27145],
        [44677, 47975],
        [62322, 15470],
        [62778, 42319],
        [21119, 20750],
        [26764, 39685],
        [55723, 8067],
        [52505, 23520]
    ];
    return (limbs[word][bit \ 16] >> (bit % 16)) & 1;
}

