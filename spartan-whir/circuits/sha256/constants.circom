        [34238, 9265],
        [32195, 21772],
        [23924, 29374],
        [45566, 32990],
        [1703, 39900],
        [61812, 49563],
        [27073, 58523],
        [18310, 61374],
        [40390, 4033],
        [41420, 9228],
        [11375, 11753],
        [33962, 19060],
        [43484, 23728],
        [35034, 30457],
        [20818, 38974],
        [50797, 43057],
        [10184, 45059],
        [32711, 48985],
        [3059, 50912],
        [37191, 54695],
        [25425, 1738],
        [10599, 5161],
        [2693, 10167],
        [8504, 11803],
        [28156, 19756],
        [3347, 21304],
        [29524, 25866],
        [2747, 30314],
        [51502, 33218],
        [11397, 37490],
        [59553, 41663],
        [26187, 43034],
        [35696, 49739],
        [20899, 51052],
        [59417, 53650],
        [1572, 54937],
        [13701, 62478],
        [41072, 4202],
        [49430, 6564],
        [27656, 7735],
        [30540, 10056],
