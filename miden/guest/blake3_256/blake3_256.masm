# Adapted from the BLAKE3 implementation in the miden-vm standard library.
# blake3.masm is the source template used by generate_programs.py.

use miden::core::sys

#! Permutes ordered message words, kept on stack top ( = sixteen 32 -bit BLAKE3 words )
#!
#! Expected stack top:
#!
#! [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15]
#!
#! After permutation, stack top:
#!
#! [s2, s6, s3, s10, s7, s0, s4, s13, s1, s11, s12, s5, s9, s14, s15, s8]
#!
#! See https://github.com/itzmeanjan/blake3/blob/f07d32ec10cbc8a10663b7e6539e0b1dab3e453b/include/blake3.hpp#!L1623-L1639
#! and https://github.com/0xMiden/miden-vm/pull/313#!discussion_r922627984
proc permute_msg_words
    movdn.7
    movup.5
    movdn.2
    movup.4
    movdn.7
    swapw.3
    swap
    movdn.7
    swapdw
    movup.2
    movdn.7
    swapw
    swapw.2
    movup.3
    movdn.6
    movdn.5
    movup.3
    swapw
    movup.3
    swapdw
end

#! Given blake3 state matrix on stack top ( in order ) as 16 elements ( each of 32 -bit ),
#! this routine computes output chaining value i.e. 2-to-1 hashing digest.
#!
#! Expected stack state:
#!
#! [state0, state1, state2, state3, state4, state5, state6, state7, state8, state9, state10, state11, state12, state13, state14, state15]
#!
#! After finalizing, stack should look like
#!
#! [dig0, dig1, dig2, dig3, dig4, dig5, dig6, dig7]
#!
#! See https://github.com/BLAKE3-team/BLAKE3/blob/da4c792/reference_impl/reference_impl.rs#!L116-L119 ,
#! you'll notice I've skipped executing second statement in loop body of above hyperlinked implementation,
#! that's because it doesn't dictate what output of 2-to-1 hash will be.
proc finalize
    movup.8
    u32xor

    swap
    movup.8
    u32xor
    swap

    movup.2
    movup.8
    u32xor
    movdn.2

    movup.3
    movup.8
    u32xor
    movdn.3

    movup.4
    movup.8
    u32xor
    movdn.4

    movup.5
    movup.8
    u32xor
    movdn.5

    movup.6
    movup.8
    u32xor
    movdn.6

    movup.7
    movup.8
    u32xor
    movdn.7
end

#! Given blake3 state matrix ( total 16 elements, each of 32 -bit ) and
#! 8 message words ( each of 32 -bit ), this routine performs column-wise mixing
#! of message words into blake3 hash state.
#!
#! Functionality wise this routine is equivalent to https://github.com/BLAKE3-team/BLAKE3/blob/da4c792/reference_impl/reference_impl.rs#!L55-L59
#!
#! Expected stack state:
#!
#! [state0_3_addr, state4_7_addr, state8_11_addr, state12_15_addr, m0, m1, m2, m3, m4, m5, m6, m7]
#!
#! Note, state_`i`_`j`_addr -> absolute address of {state[i], state[i+1], state[i+2], state[i+3]} in memory | j = i+3
#!
#! Meaning four consecutive blake3 state words can be read from memory easily.
#!
#! Final stack state:
#!
#! [state0, state1, state2, state3, state4, state5, state6, state7, state8, state9, state10, state11, state12, state13, state14, state15]
#!
#! i.e. whole blake3 state is placed on stack ( in order ).
@locals(4)
proc columnar_mixing
    swapw.2
    swapw

    movup.7
    movup.6
    movup.5
    movup.4

    loc_storew_be.0

    movup.9
    mem_loadw_be
    movup.8
    padw
    movup.4
    mem_loadw_be

    movup.8
    dup.5
    u32wrapping_add3

    swap
    movup.8
    dup.6
    u32wrapping_add3
    swap

    movup.2
    dup.6
    movup.9
    u32wrapping_add3
    movdn.2

    movup.3
    dup.7
    movup.9
    u32wrapping_add3
    movdn.3

    movup.9
    padw
    movup.4
    mem_loadw_be

    dup.4
    u32xor
    u32rotr.16

    swap
    dup.5
    u32xor
    u32rotr.16
    swap

    movup.2
    dup.6
    u32xor
    u32rotr.16
    movdn.2

    movup.3
    dup.7
    u32xor
    u32rotr.16
    movdn.3

    movup.12
    padw
    movup.4
    mem_loadw_be

    dup.4
    u32wrapping_add

    swap
    dup.5
    u32wrapping_add
    swap

    movup.2
    dup.6
    u32wrapping_add
    movdn.2

    movup.3
    dup.7
    u32wrapping_add
    movdn.3

    movupw.3

    dup.4
    u32xor
    u32rotr.12

    swap
    dup.5
    u32xor
    u32rotr.12
    swap

    movup.2
    dup.6
    u32xor
    u32rotr.12
    movdn.2

    movup.3
    dup.7
    u32xor
    u32rotr.12
    movdn.3

    movupw.3
    padw
    loc_loadw_be.0
    swapw

    movup.4
    dup.8
    u32wrapping_add3

    swap
    movup.4
    dup.8
    u32wrapping_add3
    swap

    movup.2
    movup.4
    dup.8
    u32wrapping_add3
    movdn.2

    movup.3
    movup.4
    dup.8
    u32wrapping_add3
    movdn.3

    movupw.3

    dup.4
    u32xor
    u32rotr.8

    swap
    dup.5
    u32xor
    u32rotr.8
    swap

    movup.2
    dup.6
    u32xor
    u32rotr.8
    movdn.2

    movup.3
    dup.7
    u32xor
    u32rotr.8
    movdn.3

    movupw.3

    dup.4
    u32wrapping_add

    swap
    dup.5
    u32wrapping_add
    swap

    movup.2
    dup.6
    u32wrapping_add
    movdn.2

    movup.3
    dup.7
    u32wrapping_add
    movdn.3

    movupw.3

    dup.4
    u32xor
    u32rotr.7

    swap
    dup.5
    u32xor
    u32rotr.7
    swap

    movup.2
    dup.6
    u32xor
    u32rotr.7
    movdn.2

    movup.3
    dup.7
    u32xor
    u32rotr.7
    movdn.3

    movupw.3
end

#! Given blake3 state matrix ( total 16 elements, each of 32 -bit ) and
#! 8 message words ( each of 32 -bit ), this routine performs diagonal-wise mixing
#! of message words into blake3 hash state.
#!
#! Functionality wise this routine is equivalent to https://github.com/BLAKE3-team/BLAKE3/blob/da4c792/reference_impl/reference_impl.rs#!L61-L64
#!
#! Expected stack state:
#!
#! [state0_3_addr, state4_7_addr, state8_11_addr, state12_15_addr, m0, m1, m2, m3, m4, m5, m6, m7]
#!
#! Note, state_`i`_`j`_addr -> absolute address of {state[i], state[i+1], state[i+2], state[i+3]} in memory | j = i+3
#!
#! Meaning four consecutive blake3 state words can be read from memory easily.
#!
#! Final stack state:
#!
#! [state0, state1, state2, state3, state4, state5, state6, state7, state8, state9, state10, state11, state12, state13, state14, state15]
#!
#! i.e. whole blake3 state is placed on stack ( in order ).
@locals(4)
proc diagonal_mixing
    swapw.2
    swapw

    movup.7
    movup.6
    movup.5
    movup.4

    loc_storew_be.0

    movup.9
    mem_loadw_be
    movup.8
    padw
    movup.4
    mem_loadw_be

    movup.8
    dup.6
    u32wrapping_add3

    swap
    movup.8
    dup.7
    u32wrapping_add3
    swap

    movup.2
    movup.8
    dup.8
    u32wrapping_add3
    movdn.2

    movup.3
    movup.8
    dup.5
    u32wrapping_add3
    movdn.3

    movup.9
    padw
    movup.4
    mem_loadw_be

    movup.3
    dup.4
    u32xor
    u32rotr.16
    movdn.3

    dup.5
    u32xor
    u32rotr.16

    swap
    dup.6
    u32xor
    u32rotr.16
    swap

    movup.2
    dup.7
    u32xor
    u32rotr.16
    movdn.2

    movup.12
    padw
    movup.4
    mem_loadw_be

    movup.2
    dup.7
    u32wrapping_add
    movdn.2

    movup.3
    dup.4
    u32wrapping_add
    movdn.3

    dup.5
    u32wrapping_add

    swap
    dup.6
    u32wrapping_add
    swap

    movupw.3

    swap
    dup.6
    u32xor
    u32rotr.12
    swap

    movup.2
    dup.7
    u32xor
    u32rotr.12
    movdn.2

    movup.3
    dup.4
    u32xor
    u32rotr.12
    movdn.3

    dup.5
    u32xor
    u32rotr.12

    movupw.3
    padw
    loc_loadw_be.0
    swapw

    movup.4
    dup.9
    u32wrapping_add3

    swap
    movup.4
    dup.9
    u32wrapping_add3
    swap

    movup.2
    movup.4
    dup.9
    u32wrapping_add3
    movdn.2

    movup.3
    movup.4
    dup.5
    u32wrapping_add3
    movdn.3

    movupw.3

    movup.3
    dup.4
    u32xor
    u32rotr.8
    movdn.3

    dup.5
    u32xor
    u32rotr.8

    swap
    dup.6
    u32xor
    u32rotr.8
    swap

    movup.2
    dup.7
    u32xor
    u32rotr.8
    movdn.2

    movupw.3

    movup.2
    dup.7
    u32wrapping_add
    movdn.2

    movup.3
    dup.4
    u32wrapping_add
    movdn.3

    dup.5
    u32wrapping_add

    swap
    dup.6
    u32wrapping_add
    swap

    movupw.3

    swap
    dup.6
    u32xor
    u32rotr.7
    swap

    movup.2
    dup.7
    u32xor
    u32rotr.7
    movdn.2

    movup.3
    dup.4
    u32xor
    u32rotr.7
    movdn.3

    dup.5
    u32xor
    u32rotr.7

    movupw.3
end

#! Given blake3 state matrix ( total 16 elements, each of 32 -bit ) and
#! 16 message words ( each of 32 -bit ), this routine applies single round of mixing
#! of message words into hash state i.e. msg_word[0..8] are mixed into hash state using
#! columnar mixing while remaining message words ( msg_word[8..16] ) are mixed into hash state
#! using diagonal mixing.
#!
#! Functionality wise this routine is equivalent to https://github.com/BLAKE3-team/BLAKE3/blob/da4c792/reference_impl/reference_impl.rs#!L54-L65
#!
#! Expected stack state:
#!
#! [state0_3_addr, state4_7_addr, state8_11_addr, state12_15_addr, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15]
#!
#! Note, state_`i`_`j`_addr -> absolute address of {state[i], state[i+1], state[i+2], state[i+3]} in memory | j = i+3
#!
#! Meaning four consecutive blake3 state words can be read from memory easily.
#!
#! Final stack state:
#!
#! [...]
#!
#! i.e. mixed state matrix lives in memory addresses {state0_3_addr, state4_7_addr, state8_11_addr, state12_15_addr},
#! which were provided, on stack top, while invoking this routine.
@locals(20)
proc round
    loc_storew_be.0

    exec.columnar_mixing

    loc_storew_be.4
    dropw
    loc_storew_be.8
    dropw
    loc_storew_be.12
    dropw
    loc_storew_be.16
    dropw

    locaddr.16
    locaddr.12
    locaddr.8
    locaddr.4

    exec.diagonal_mixing

    padw
    loc_loadw_be.0
    swapw
    movup.4
    mem_storew_be
    dropw

    repeat.3
        push.0
        movdn.3
        swapw
        movup.4
        mem_storew_be
        dropw
    end

    repeat.3
        drop
    end
end

#! Given blake3 state matrix ( total 16 elements, each of 32 -bit ) and a message block
#! i.e. 16 message words ( each of 32 -bit ), this routine applies 7 rounds of mixing
#! of (permuted) message words into hash state.
#!
#! Functionality wise this routine is equivalent to https://github.com/BLAKE3-team/BLAKE3/blob/da4c792/reference_impl/reference_impl.rs#!L75-L114
#!
#! Expected stack state:
#!
#! [state0_3_addr, state4_7_addr, state8_11_addr, state12_15_addr, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15]
#!
#! Note, state_`i`_`j`_addr -> absolute address of {state[i], state[i+1], state[i+2], state[i+3]} in memory | j = i+3
#!
#! Meaning four consecutive blake3 state words can be read from memory easily.
#!
#! Final stack state:
#!
#! [...]
#!
#! i.e. 7 -round mixed state matrix lives in memory addresses {state0_3_addr, state4_7_addr, state8_11_addr, state12_15_addr},
#! which were provided, on stack top, while invoking this routine. So updated state matrix can be read by caller routine, by reading
#! the content of memory addresses where state was provided as routine input.
@locals(4)
proc compress
    loc_storew_be.0
    dropw

    # apply first 6 rounds of mixing
    repeat.6
        # round `i` | i ∈ [1..7)
        repeat.4
            dupw.3
        end

        padw
        loc_loadw_be.0
        exec.round
        exec.permute_msg_words
    end

    # round 7 ( last round, so no message word permutation required )
    padw
    loc_loadw_be.0
    exec.round
end

# Compress one full 64-byte BLAKE3 block.
#
# Input:
# [m0..m15, cv0..cv7, counter_low, counter_high, 64, flags]
#
# Output:
# [out0..out7]
@locals(32)
proc compress_full_block
    # Preserve the message, chaining value, and final state word.
    loc_storew_be.16 dropw
    loc_storew_be.20 dropw
    loc_storew_be.24 dropw
    loc_storew_be.28 dropw
    loc_storew_be.0 dropw
    loc_storew_be.4 dropw
    loc_storew_be.12 dropw

    # state[8..11] = IV[0..3].
    push.0xA54FF53A.0x3C6EF372.0xBB67AE85.0x6A09E667
    locaddr.8
    mem_storew_be
    dropw

    # Rebuild the message on the stack, then put the four state addresses above it.
    padw loc_loadw_be.28
    padw loc_loadw_be.24
    padw loc_loadw_be.20
    padw loc_loadw_be.16
    locaddr.12
    locaddr.8
    locaddr.4
    locaddr.0
    exec.compress

    padw loc_loadw_be.12
    padw loc_loadw_be.8
    padw loc_loadw_be.4
    padw loc_loadw_be.0
    exec.finalize
end

# Reset the active chaining value to the BLAKE3 IV.
proc reset_cv
    push.0xA54FF53A.0x3C6EF372.0xBB67AE85.0x6A09E667
    mem_storew_be.20000
    dropw
    push.0x5BE0CD19.0x1F83D9AB.0x9B05688C.0x510E527F
    mem_storew_be.20004
    dropw
end

# Input: [counter_low, counter_high, 64, flags].
# Consumes one 64-byte block (sixteen reversed little-endian u32s) from advice.
proc consume_advice_block
    padw mem_loadw_be.20004
    padw mem_loadw_be.20000

    # Advice supplies m15 first and m0 last, leaving [m0..m15] on top.
    repeat.16
        adv_push
        u32assert
    end

    exec.compress_full_block

    mem_storew_be.20000
    dropw
    mem_storew_be.20004
    dropw
end

# Generated by blake3/generate_programs.py for 256 input bytes.
# The input-size branch and block loop are fully unrolled.
begin
    exec.reset_cv
    push.1.64.0.0
    exec.consume_advice_block
    push.0.64.0.0
    exec.consume_advice_block
    push.0.64.0.0
    exec.consume_advice_block
    push.10.64.0.0
    exec.consume_advice_block
    padw mem_loadw_be.20004
    padw mem_loadw_be.20000
    exec.sys::truncate_stack
end
