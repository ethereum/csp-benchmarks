pragma circom 2.0.2;

// Generated file: the 22 lookup tables of the width-12 signed-digit comb for
// the P-256 generator G, and one lookup template per window. Not edited by
// hand; CombFixedBaseP256 in comb_fixed_p256.circom consumes it.
//
//     table_i[j] = (2j + 1) * 2^(12 i) * G,   i in [0, 22),  j in [0, 2048)
//
// Each point is stored as 8 little-endian 64-bit limbs, x0..x3 then y0..y3.
// A window outputs the selected point as 16 little-endian 32-bit limbs,
// x0..x7 then y0..y7; the 32-bit coefficients are split from the stored
// limbs at compile time. Only odd multiples are stored; a negative digit
// negates y inside the circuit.
//
// The comb follows the public description of rot256's (Mathias
// Hall-Andersen) submission to the zk.golf secp256k1 fixed-base scalar
// multiplication challenge, applied here to P-256. No code was copied.

// One-hot decoding of b bits into 2^b selectors with 2^b - 1 constraints.
// Bit i lands on index bit i: the "bit = 1" half of step i goes to j + 2^i.
template P256OneHot(b) {
    signal input bits[b];
    signal output oh[1 << b];

    signal inter[b + 1][1 << b];
    inter[0][0] <== 1;
    for (var j = 1; j < (1 << b); j++) { inter[0][j] <== 0; }

    for (var i = 0; i < b; i++) {
        for (var j = 0; j < (1 << i); j++) {
            inter[i + 1][j + (1 << i)] <== inter[i][j] * bits[i];
            inter[i + 1][j]            <== inter[i][j] - inter[i + 1][j + (1 << i)];
        }
        for (var j = (1 << (i + 1)); j < (1 << b); j++) { inter[i + 1][j] <== 0; }
    }
    for (var j = 0; j < (1 << b); j++) { oh[j] <== inter[b][j]; }
}
