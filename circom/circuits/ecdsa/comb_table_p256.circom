template P256CombWindow3() {
    signal input sel[11];     // index bits, sel[0] least significant
    signal output out[16];    // x0..x7, y0..y7, 32-bit limbs

    var T[2048][8] = p256_comb_table_3();

    component ohLo = P256OneHot(7);
    for (var i = 0; i < 7; i++) { ohLo.bits[i] <== sel[i]; }
    component ohHi = P256OneHot(4);
    for (var i = 0; i < 4; i++) { ohHi.bits[i] <== sel[7 + i]; }

    // Inner sum: linear in ohLo, so it costs no constraints. Output limb l is
    // the low or high half of stored 64-bit limb l / 2.
    signal partial[16][16];
    for (var a = 0; a < 16; a++) {
        for (var l = 0; l < 16; l++) {
            var acc = 0;
            for (var b = 0; b < 128; b++) {
                acc += ohLo.oh[b] * ((T[a * 128 + b][l \ 2] >> (32 * (l % 2))) & 4294967295);
            }
            partial[a][l] <== acc;
        }
    }

    // Outer sum. An R1CS constraint admits one product, so
    // sum_a ohHi[a] * partial[a][l] needs 16 intermediate signals;
    // adding those up is linear, hence free.
    signal prod[16][16];
    for (var a = 0; a < 16; a++) {
        for (var l = 0; l < 16; l++) { prod[a][l] <== ohHi.oh[a] * partial[a][l]; }
    }
    for (var l = 0; l < 16; l++) {
        var acc = 0;
        for (var a = 0; a < 16; a++) { acc += prod[a][l]; }
        out[l] <== acc;
    }
}
